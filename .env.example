# 代理 Compose 使用的变量；建议与 Java 服务共用同一份部署 .env。
DB_PASSWORD=
DB_USER=root
DB_NAME=flexi_admin
DB_PORT=3306
DB_HOST=host.docker.internal
AI_PROXY_PORT=8010
AI_PROXY_BIND_HOST=127.0.0.1
CORS_ORIGINS=http://localhost:5174,http://127.0.0.1:5174
JWT_SECRET=请填写随机密钥并与Java服务使用相同值
AI_PROXY_INTERNAL_TOKEN=请填写另一个随机令牌并与Java服务使用相同值
GEMINI_REFRESH_INTERVAL=600
OSS_ACCESS_ID=
OSS_ACCESS_KEY=
OSS_ENDPOINT=https://oss-cn-beijing.aliyuncs.com
OSS_BUCKET=jyf6
# 三平台和进程总执行额度，必须显式配置。
GPT_LIMIT=100
GEMINI_LIMIT=100
DOUBAO_LIMIT=100
MODEL_GLOBAL_LIMIT=150
GPT_REFRESH_CONCURRENCY=5
