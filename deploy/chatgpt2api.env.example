# 服务器文件：/etc/flexi/chatgpt2api.env；由 systemd 的 EnvironmentFile 加载。
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=flexi_admin
MYSQL_USER=root
MYSQL_PASSWORD=
REDIS_URL=redis://127.0.0.1:6379/0
GEMINI_REFRESH_INTERVAL=600
REMBG_HOME=/var/lib/flexi-ai/rembg
PYTHONUNBUFFERED=1
OSS_ACCESS_ID=
OSS_ACCESS_KEY=
OSS_ENDPOINT=https://oss-cn-beijing.aliyuncs.com
OSS_BUCKET=jyf6
